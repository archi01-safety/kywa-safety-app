# One-time AX server settings. Copy OUTSIDE the unpacked application directory.
# The KYWA ZIP discovers /var/lib/ax-apps/kywa-safety/ax.env automatically.
# Or set APP_ENV_FILE=/approved/private/path/kywa-safety.env in the AX service.
# Keep that file and the service environment when replacing the app ZIP.
APP_ENV=production
ORGANIZATION_ID=kywa
APP_BASE_URL=https://ax.kywa.or.kr
APP_BASE_PATH=/apps/kywa-safety
AUTH_MODE=pin
# PORT is supplied by AX. Do not copy Render's PORT=10000.
HOST=127.0.0.1
APP_DATA_DIR=/var/lib/ax-apps/kywa-safety
HISTORY_SHEET_NAME=조치이력
ALLOW_LEGACY_WRITES=true
DETAILED_RISK_ENABLED=true
# Empty storage settings use the checked KYWA institution configuration.
# The prepared private file pins the actual existing storage values as well.
# SPREADSHEET_ID=
# SHEET_NAME=설문지 응답 시트1
# DRIVE_FOLDER_ID=
# Values below are private and must be supplied ONCE on the AX server.
GOOGLE_SERVICE_ACCOUNT_JSON=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
KOSHA_API_KEY=
LAW_API_OC=
ADMIN_PIN_HASH=
SESSION_SECRET=
