# Local preview uses synthetic analysis and disposable local data.
APP_ENV=demo
# Only enable on the independent KYWA development service with its synthetic workbook.
PILOT_READS=false
APP_BASE_URL=http://localhost:8000
# AX prefix (same at frontend build and server startup); empty for Render/root.
APP_BASE_PATH=
# AX launcher: PORT from the platform, HOST defaults to 127.0.0.1.
# APP_DATA_DIR=/var/lib/ax-apps/your-app
# APP_UPLOAD_DIR=/var/lib/ax-apps/your-app/tmp
# APP_LOG_DIR=/var/log/ax-apps/your-app
# Optional APP_ENV_FILE points to an external private env file; it is not packed.
# FORWARDED_ALLOW_IPS=127.0.0.1
SESSION_SECRET=local-demo-only-change-this-before-real-deployment
# Use AUTH_MODE=pin for shared administrator login; generate a private hash with scripts/set_admin_pin.py.
# OAuth settings are only required in google mode. Never put a PIN in this example or frontend code.
AUTH_MODE=google
ADMIN_PIN_HASH=
# Real test: APP_ENV=development, HTTPS URL, and separate test sheet/folder.
# Never commit .env. Use Render Environment for deployed secrets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Empty IDs inherit the server-side institution storage config.
SPREADSHEET_ID=
# Omit SHEET_NAME to use the institution default (KYWA: 설문지 응답 시트1; others: 시트1).
HISTORY_SHEET_NAME=조치이력
DRIVE_FOLDER_ID=
# This deployment uses the specified service account directly; leave delegation empty.
GOOGLE_DELEGATE_EMAIL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
KOSHA_API_KEY=
ACCESS_ACCOUNTS_JSON='{"admin@example.org":{"role":"admin","facilities":[]},"staff@example.org":{"role":"staff","facilities":["중앙"]}}'
# Set true only for APP_ENV=production after backup and header preparation.
ALLOW_LEGACY_WRITES=false
REPORT_MAX_ROWS=100

# Deployment-specific organization policy (backend/organizations/<id>.json)
ORGANIZATION_ID=kywa
